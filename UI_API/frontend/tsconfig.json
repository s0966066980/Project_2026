{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ESNext.Disposable"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "types.d.ts",
    "shared/contracts/**/*.ts",
    "shared/api/**/*.ts",
    "tests/**/*.ts",
    "kiosk/features/**/*.js",
    "admin/features/**/*.js",
    "shared/httpClient.js",
    "shared/apiClient.js",
    "shared/realtimeClient.js",
    "shared/hooks/useDomEvents.js",
    "shared/components/VisibilityDisplay.js",
    "kiosk/runtime.js",
    "kiosk/cart.js",
    "kiosk/controllers/kioskMenuController.js",
    "kiosk/constants/kiosk.js",
    "kiosk/menuVisuals.js"
  ]
}
