# Production commercial runtime. NO demo defaults. Secrets must be injected.
# This file is NOT Production Certified evidence by itself.
APP_ENV=production
SECURITY_ENFORCED=true
ALLOW_UNSAFE_PRODUCTION_ROUTES=false
ENABLE_DEMO_ROUTES=false
ENABLE_TEST_ROUTES=false
ENABLE_DEBUG_ROUTES=false
MEMBER_STORAGE_BACKEND=postgres
ALLOW_POSTGRES_JSON_FALLBACK=false
STRUCTURED_LOGGING_ENABLED=true
LOG_RETENTION_DAYS=90
SHARED_RATE_LIMIT_ENABLED=true
DATABASE_URL=postgresql://project2026:CHANGE_ME_INJECT_FROM_SECRET_MANAGER@postgres:5432/project2026
REDIS_URL=redis://redis:6379/0
ADMIN_MEMBER_REF_SECRET=CHANGE_ME_INJECT_FROM_SECRET_MANAGER
ENABLE_LEGACY_ADMIN_TOKEN=false
ENABLE_LEGACY_KIOSK_TOKEN=false
MEMBER_IDENTITY_READ_MODE=legacy
MEMBER_IDENTITY_DUAL_WRITE=false
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_STORE_ID=00000000-0000-4000-8000-000000000002
DEFAULT_DEVICE_ID=00000000-0000-4000-8000-000000000003
CORS_ORIGINS=https://kiosk.example,https://admin.example
API_CPU_LIMIT=4.0
API_MEMORY_LIMIT_MB=4096
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT_MB=2048
POSTGRES_POOL_SIZE=40
HTTP_TIMEOUT_SECONDS=30
AI_GATEWAY_TIMEOUT_SECONDS=15
# GPU gateways remain separate processes/images — do not embed model weights here.
