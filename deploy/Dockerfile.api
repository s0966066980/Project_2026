# API process image. GPU model trees (Emotion-LLaMA, R1-Omni) are intentionally excluded.
# Build context: repository root.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    APP_HOST=0.0.0.0 \
    APP_PORT=8000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY UI_API/requirements-ci.txt /app/requirements-ci.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r /app/requirements-ci.txt

COPY UI_API /app/UI_API

WORKDIR /app/UI_API

EXPOSE 8000 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${APP_PORT}/live" || exit 1

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
