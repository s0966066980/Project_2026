# Single-store Local Kiosk Pilot profile — EXAMPLE ONLY.
#
# This file is not a Pilot Configuration Authority and cannot be used to declare
# Local Pilot Readiness. Copy it to a host-external location outside the Git
# repository, fill in real values, and point PILOT_ENV_FILE at the copy:
#
#   install -d -m 0700 ~/.config/project-2026
#   cp config/profiles/local-pilot.env.example ~/.config/project-2026/pilot.env
#   # edit, then hand ownership to the container runtime principal:
#   sudo chown 10001:10001 ~/.config/project-2026/pilot.env
#   sudo chmod 0600 ~/.config/project-2026/pilot.env
#
# The application refuses to read a configuration or secret file whose
# permissions are looser than 0600, and the container runs as uid 10001, so any
# other ownership fails closed.
#
# APP_ENV, SECURITY_ENFORCED and the route switches are NOT set here: they are
# fixed by docker/compose.pilot.yaml so that a Pilot cannot be talked out of
# them by an edited configuration file.

DATABASE_BACKEND=postgresql
DATABASE_TOPOLOGY=single

# Inside the container the runtime data volume is mounted here. Do not point
# this at a host path; the container is what reads it.
RUNTIME_DATA_ROOT=/var/lib/project-2026

# Granted SELECT/INSERT/UPDATE/DELETE by the migration. Provision it before the
# first Pilot start or the first migration fails:
#
#   bash docker/scripts/provision-pilot-database-role.sh
#
# The application still connects as the owning role; moving the runtime
# connection onto this least-privilege role is Operations & Configuration work.
DATABASE_RUNTIME_ROLE=project_runtime

LOG_RETENTION_DAYS=90
MEMBER_IDENTITY_READ_MODE=legacy
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=
RAG_COLLECTION=kiosk_rag

LLM_PORT=ollama
MULTIMODAL_PORT=disabled
OBJECT_STORAGE_PORT=local
PAYMENT_BACKEND=manual
POS_BACKEND=manual

# Redis is optional for a single API process pilot. Shared rate limiting
# requires REDIS_URL when enabled.
REDIS_URL=
SHARED_RATE_LIMIT_ENABLED=false

DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_STORE_ID=00000000-0000-4000-8000-000000000002
DEFAULT_DEVICE_ID=00000000-0000-4000-8000-000000000003

# Real secrets go in the host-external copy only — never in this example, never
# in the repository, never in an image layer. Startup rejects placeholder
# values such as "changeme", "secret" or "test".
ADMIN_MEMBER_REF_SECRET=
OBJECT_STORAGE_SIGNING_SECRET=

# Trusted bootstrap writes these outside the repository with mode 0600.
ADMIN_PROVISIONING_BUNDLE_FILE=/run/secrets/admin_login
KIOSK_PROVISIONING_BUNDLE_FILE=/run/secrets/device_provisioning

# Bootstrap (do not commit password)
# ADMIN_BOOTSTRAP_PASSWORD=

# The PostgreSQL URLs are NOT set here. They are separate host-external secret
# files referenced by PILOT_DATABASE_URL_FILE and
# PILOT_MIGRATION_DATABASE_URL_FILE, mounted at /run/secrets by
# docker/compose.pilot.yaml. Configuring both a URL and a URL file for the same
# name is rejected at startup.
