# Single-store Local Kiosk Pilot profile — copy values into .env, never commit secrets.
APP_PROFILE=local-pilot
APP_ENV=pilot
DATABASE_BACKEND=postgresql
DATABASE_TOPOLOGY=single
RUNTIME_DATA_ROOT=/home/oliver/.local/share/project-2026
SECURITY_ENFORCED=true
ENABLE_LEGACY_KIOSK_TOKEN=false
ENABLE_DEMO_ROUTES=false
ENABLE_DIAGNOSTIC_ROUTES=false
ENABLE_DEBUG_ROUTES=false
ALLOW_UNSAFE_PRODUCTION_ROUTES=false
ENABLE_NGROK=false
STRUCTURED_LOGGING_ENABLED=true

# Runtime paths derive from RUNTIME_DATA_ROOT unless explicitly overridden.
RAG_COLLECTION=kiosk_rag

# Inject real values via environment / secret manager — placeholders only here
DATABASE_URL_FILE=/home/oliver/.config/project-2026/secrets/database_url
MIGRATION_DATABASE_URL_FILE=/home/oliver/.config/project-2026/secrets/migration_database_url
DATABASE_RUNTIME_ROLE=project_runtime
ADMIN_MEMBER_REF_SECRET=
OBJECT_STORAGE_SIGNING_SECRET=
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_STORE_ID=00000000-0000-4000-8000-000000000002
DEFAULT_DEVICE_ID=00000000-0000-4000-8000-000000000003

# Trusted bootstrap writes these outside the repository with mode 0600.
ADMIN_PROVISIONING_BUNDLE_FILE=/home/oliver/.config/project-2026/secrets/admin-login.json
KIOSK_PROVISIONING_BUNDLE_FILE=/home/oliver/.config/project-2026/secrets/device-1-provisioning.json

LLM_PORT=ollama
MULTIMODAL_PORT=disabled
OBJECT_STORAGE_PORT=local
PAYMENT_BACKEND=manual
POS_BACKEND=manual

# Redis optional for single API process pilot
REDIS_URL=
SHARED_RATE_LIMIT_ENABLED=false

# Bootstrap (do not commit password)
# ADMIN_BOOTSTRAP_PASSWORD=
