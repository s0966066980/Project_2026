# Project_2026 development baseline.
# Copy to .env and replace every CHANGE_ME value locally. Never commit .env.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=9000
ADMIN_PORT=9001
SECURITY_ENFORCED=false
ALLOW_UNSAFE_PRODUCTION_ROUTES=false
ENABLE_DEMO_ROUTES=true
ENABLE_DIAGNOSTIC_ROUTES=true
ENABLE_DEBUG_ROUTES=false

# Browser origins (comma-separated, no wildcard in production)
CORS_ORIGINS=http://127.0.0.1:9000,http://127.0.0.1:9001,http://localhost:9000,http://localhost:9001
PUBLIC_POS_ORIGIN=http://127.0.0.1:9000
PUBLIC_ADMIN_ORIGIN=http://127.0.0.1:9001

# Admin authentication uses only a password-authenticated durable session.
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_TTL_SEC=28800
KIOSK_DEVICE_TOKEN=
ENABLE_LEGACY_KIOSK_TOKEN=true
DEVICE_SESSION_COOKIE_NAME=kiosk_device_session
DEVICE_SESSION_TTL_SEC=3600
DEVICE_CREDENTIAL_TTL_DAYS=90
DEVICE_CREDENTIAL_ROTATION_GRACE_SEC=300
ADMIN_MEMBER_REF_SECRET=
POS_DEMO_TOKEN=
WS_DEMO_TOKEN=

# Runtime Persistence Profile. MEMBER_STORAGE_BACKEND and DATABASE_PORT are
# rejected because database selection has exactly one authority.
DATABASE_BACKEND=postgresql
DATABASE_TOPOLOGY=single
RUNTIME_DATA_ROOT=/home/oliver/.local/share/project-2026
DATABASE_URL_FILE=/home/oliver/.config/project-2026/secrets/database_url
MIGRATION_DATABASE_URL_FILE=/home/oliver/.config/project-2026/secrets/migration_database_url
DATABASE_RUNTIME_ROLE=project_runtime
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=5
STRUCTURED_LOGGING_ENABLED=true
LOG_RETENTION_DAYS=90
MEMBER_IDENTITY_READ_MODE=legacy
MEMBER_IDENTITY_DUAL_WRITE=false
# Required when enabling dual/UUID identity modes. Use deployment secrets; do not commit values.
MEMBER_PHONE_KEY_VERSION=
MEMBER_PHONE_LOOKUP_PEPPER=
MEMBER_PHONE_ENCRYPTION_KEY=
# Rotation keyrings may be supplied as Secret-Manager-rendered JSON maps instead of single values.
MEMBER_PHONE_LOOKUP_PEPPERS_JSON=
MEMBER_PHONE_ENCRYPTION_KEYS_JSON=
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_STORE_ID=00000000-0000-4000-8000-000000000002
DEFAULT_DEVICE_ID=00000000-0000-4000-8000-000000000003

# Ephemeral shared infrastructure; required for production security rate limits.
REDIS_URL=
SHARED_RATE_LIMIT_ENABLED=false
# Reserved for later infrastructure milestones
JWT_SECRET=
# Object storage: memory (test) | local (dev/pilot) | s3 (requires cloud credentials)
OBJECT_STORAGE_BACKEND=memory
OBJECT_STORAGE_LOCAL_ROOT=
OBJECT_STORAGE_SIGNING_SECRET=
OBJECT_STORAGE_ENCRYPTION=none-test
OBJECT_STORAGE_ENCRYPTION_KEY=
OBJECT_STORAGE_ENCRYPTION_KEY_VERSION=v1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_S3_ENCRYPTION=provider-managed

# LLM providers
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen3.5:4b
# NVIDIA NIM: the sole cloud text provider. Selected in Admin → 功能設定 → AI 模型 via the
# routing policy; the key itself never enters the settings document.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Speech providers
STT_PROVIDER=faster_whisper
STT_API_URL=https://api.openai.com
STT_API_KEY=
TTS_PROVIDER=edge
TTS_API_URL=https://api.openai.com
TTS_API_KEY=

# Emotion gateways
R1_OMNI_GRADIO_URL=http://127.0.0.1:7890

# Optional local tooling
ENABLE_NGROK=false
NGROK_AUTHTOKEN=
OPEN_BROWSER=false
