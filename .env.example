# Project_2026 development baseline.
# Copy to .env and replace every CHANGE_ME value locally. Never commit .env.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=9000
ADMIN_PORT=9001
SECURITY_ENFORCED=false
ALLOW_UNSAFE_PRODUCTION_ROUTES=false
ENABLE_DEMO_ROUTES=true
ENABLE_TEST_ROUTES=true
ENABLE_DEBUG_ROUTES=false

# Browser origins (comma-separated, no wildcard in production)
CORS_ORIGINS=http://127.0.0.1:9000,http://127.0.0.1:9001,http://localhost:9000,http://localhost:9001
PUBLIC_POS_ORIGIN=http://127.0.0.1:9000
PUBLIC_ADMIN_ORIGIN=http://127.0.0.1:9001

# Backward-compatible credentials; development only. Production uses the
# database-backed Admin session and keeps this flag false after cutover.
ADMIN_API_TOKEN=
ENABLE_LEGACY_ADMIN_TOKEN=true
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_TTL_SEC=28800
KIOSK_DEVICE_TOKEN=
ENABLE_LEGACY_KIOSK_TOKEN=true
DEVICE_SESSION_COOKIE_NAME=kiosk_device_session
DEVICE_SESSION_TTL_SEC=3600
ADMIN_MEMBER_REF_SECRET=
POS_DEMO_TOKEN=
ADMIN_DEMO_TOKEN=
WS_DEMO_TOKEN=

# PostgreSQL compatibility storage
MEMBER_STORAGE_BACKEND=json
DATABASE_URL=
ALLOW_POSTGRES_JSON_FALLBACK=false
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_STORE_ID=00000000-0000-4000-8000-000000000002
DEFAULT_DEVICE_ID=00000000-0000-4000-8000-000000000003
POSTGRES_ENABLED=false
POSTGRES_USER=ui_api_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ui_api
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Reserved for later infrastructure milestones
REDIS_URL=
JWT_SECRET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# LLM providers
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen3.5:4b
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Speech providers
STT_PROVIDER=faster_whisper
STT_API_URL=https://api.openai.com
STT_API_KEY=
TTS_PROVIDER=edge
TTS_API_URL=https://api.openai.com
TTS_API_KEY=

# Emotion gateways
EMOTION_LLAMA_GRADIO_URL=http://127.0.0.1:7889
R1_OMNI_GRADIO_URL=http://127.0.0.1:7890

# Optional local tooling
ENABLE_NGROK=false
NGROK_AUTHTOKEN=
OPEN_BROWSER=false
