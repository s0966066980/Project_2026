# Copy this file to .env before exposing the stack outside your own machine.
APP_PORT=8000
# Keep loopback for one-machine use. Change to 0.0.0.0 only for trusted LAN access.
BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Full AI Compose overlay settings (compose.ai.yaml).
OLLAMA_MODEL=qwen3.5:4b
STT_MODEL=small
TTS_PROVIDER=edge
TTS_MODEL=default
EDGE_TTS_VOICE=zh-TW-HsiaoChenNeural
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_STRATEGY=hybrid
# Optional cloud fallback/provider. Leave empty when using local Ollama only.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# R1-Omni never downloads weights. This host directory is mounted read-only.
R1_MODELS_PATH=../R1-Omni/models
OLLAMA_PORT=11434
R1_OMNI_PORT=7890
